# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (wajib)
# Contoh: postgres://user:password@localhost:5432/money_management
DATABASE_URL=postgres://postgres:password@localhost:5432/money_management

# Opsional: pakai SSL saat koneksi (true/false). Default: tanpa SSL.
# DATABASE_SSL=false

# Opsional: jumlah koneksi maksimum di pool (default 10)
# DB_POOL_MAX=10

# ── Integrasi Telegram (opsional) ────────────────────────────────────────────
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN=
# Secret acak untuk memverifikasi webhook (Telegram mengirimnya sebagai header
# X-Telegram-Bot-Api-Secret-Token). Buat dengan: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Username bot tanpa "@" — hanya dipakai untuk ditampilkan di UI
TELEGRAM_BOT_USERNAME=

# ── Gemini (opsional, dipakai bila integrasi Telegram aktif) ─────────────────
# API key dari https://aistudio.google.com/apikey
# Boleh beberapa key dipisah koma (idealnya dari project Google berbeda):
#   GEMINI_API_KEY=keyA,keyB
# Bila kuota satu model/key habis, otomatis pindah ke model/key berikutnya.
GEMINI_API_KEY=
# Model yang dipakai untuk parsing pesan + OCR struk
GEMINI_MODEL=gemini-3.5-flash-lite
