# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL (wajib)
# Contoh: postgres://user:password@localhost:5432/money_management
DATABASE_URL=postgres://postgres:password@localhost:5432/money_management

# Opsional: pakai SSL saat koneksi (true/false). Default: tanpa SSL.
# DATABASE_SSL=false

# Opsional: jumlah koneksi maksimum di pool (default 10)
# DB_POOL_MAX=10
