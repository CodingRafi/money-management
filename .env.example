# Better Auth
BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter
BETTER_AUTH_URL=http://localhost:3000

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL
# Contoh: postgres://user:password@localhost:5432/money_management
DATABASE_URL=postgres://user:password@localhost:5432/money_management

# Google OAuth (buat di https://console.cloud.google.com)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
